# ============================================
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# ============================================
# Media / Uploads (Keep structure, ignore content)
# ============================================
# Backend media files - ignore uploaded content but keep directory structure
backend/media/videos/*
!backend/media/videos/.gitkeep
backend/media/thumbnails/*
!backend/media/thumbnails/.gitkeep
backend/media/avatars/*
!backend/media/avatars/.gitkeep
backend/media/documents/*
!backend/media/documents/.gitkeep
backend/media/live_recordings/*
!backend/media/live_recordings/.gitkeep

# Frontend public uploads (if any)
frontend/public/uploads/*
!frontend/public/uploads/.gitkeep

# ============================================
# Temporary Files
# ============================================
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~
.cache/
temp/
tmp/

# ============================================
# Build Artifacts
# ============================================
*.o
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out
*.app

# ============================================
# Alembic (Keep migrations, ignore cache)
# ============================================
# Alembic migration files should be committed
# But ignore any cache or temporary files
backend/alembic/__pycache__/
*.pyc

# ============================================
# Docker
# ============================================
.dockerignore
docker-compose.override.yml
*.dockerignore

# ============================================
# Misc
# ============================================
# SSL certificates
*.pem
*.key
*.crt
*.cert

# Secrets
secrets/
*.secret
*.key
!*.example.key

# Reports
*.report
reports/
test-results/

# Coverage
.nyc_output/
coverage/

# Storybook
storybook-static/

# Turbo
.turbo/

# ============================================
# Project Specific
# ============================================
# Keep these files/directories
!backend/media/.gitkeep
!backend/media/videos/.gitkeep
!backend/media/thumbnails/.gitkeep
!backend/media/avatars/.gitkeep
!backend/media/documents/.gitkeep
!backend/media/live_recordings/.gitkeep

# Ignore nested node_modules in backend (if any)
backend/node_modules/
backend/frontend/
backend/backend/

# Ignore any test databases
*.test.db
*.test.sqlite

# Ignore local development scripts
local_*.sh
local_*.py
!scripts/

# Ignore personal notes
NOTES.md
TODO_PERSONAL.md
*.personal.*