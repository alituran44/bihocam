{
    email admin@bihocam.com
}

# Main Web Platform (HTTPS automatic with Let's Encrypt)
bihocam.com, www.bihocam.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
    }

    # Strix Pentest: Dotfiles Protection (Allow RFC 9116 .well-known)
    @dotfiles {
        path */.*
        not path /.well-known/*
    }
    respond @dotfiles 404

    # Core Web Vitals & TTFB: Next.js Static Asset Caching
    @staticFiles {
        path /_next/static/*
        path /static/*
        path *.ico *.png *.jpg *.jpeg *.svg *.webp *.woff2
    }
    header @staticFiles Cache-Control "public, max-age=31536000, immutable"

    # 5651 ve GİB için Gerçek İstemci Başlıklarını Aktar
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Port {remote_port}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Next.js Frontend SSR & Static
    handle {
        reverse_proxy frontend:3000
    }
}

# Dedicated API Subdomain
api.bihocam.com {
    encode zstd gzip

    reverse_proxy backend:8000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Port {remote_port}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Direct IP Access fallback
:80 {
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy frontend:3000
    }
}
