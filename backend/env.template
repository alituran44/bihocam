# ============================================
# BiHocam Backend - Environment Variables
# ============================================
# Bu dosyayi .env olarak kopyalayin ve degerleri doldurun:
#   copy env.template .env  (Windows)
#   cp env.template .env    (Linux/Mac)

# ── Ortam (development icin true, production icin false) ──
DEBUG=true

# ── Database ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bihocam

# ── Security ──
# Production'da (DEBUG=false) en az 32 karakterlik guclu bir anahtar ZORUNLUDUR.
# Ornek olusturma: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=BURAYA-GUCLU-BIR-ANAHTAR-YAZIN-EN-AZ-32-KARAKTER
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──
CORS_ORIGINS=["http://localhost:3454"]

# ── Redis (e-posta kuyrugu icin) ──
REDIS_URL=redis://localhost:6379/0

# ── SMTP / Email ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_DEFAULT_FROM=no-reply@bihocam.com

# ── Platform ──
PLATFORM_COMMISSION_RATE=0.35
# Development: http://localhost:3454 | Production: https://bihocam.summarify.io
FRONTEND_URL=http://localhost:3454

# ── Storage ──
STORAGE_BACKEND=local
MEDIA_ROOT=media
MAX_VIDEO_SIZE_MB=500
MAX_AVATAR_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=50

# ── PayTR Odeme Entegrasyonu ──
# Magaza Paneli > Destek & Kurulum > Entegrasyon Bilgileri'nden alinir
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
PAYTR_DEBUG=1
PAYTR_MAX_INSTALLMENT=12
PAYTR_NO_INSTALLMENT=0
PAYTR_TIMEOUT_LIMIT=30
PAYTR_CURRENCY=TL

# ── Ilk Admin Kullanicisi (setup_fresh_db.py icin) ──
ADMIN_EMAIL=admin@bihocam.com
ADMIN_PASSWORD=admin123456
ADMIN_NAME=BiHocam Admin
